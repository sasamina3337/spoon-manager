#include <windows.h>
IDI_APP_ICON ICON "@PROJECT_SOURCE_DIR@/desktop/renderer/icons/reader.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "Spoon Manager\0"
   VALUE "CompanyName", "sasamina\0"
   VALUE "LegalCopyright", "sasamina\0"
   VALUE "FileVersion", "@PROJECT_VERSION@\0"
   VALUE "InternalName", "SpoonManager\0"
   VALUE "OriginalFilename", "SpoonManager.exe\0"
   VALUE "ProductName", "Spoon Manager\0"
   VALUE "ProductVersion", "@PROJECT_VERSION@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
