cmake_minimum_required(VERSION 3.25)
string(RANDOM LENGTH 12 ALPHABET abcdef0123456789 suffix)
set(root "${TEST_ROOT}/renderer-${suffix}")
if(EXISTS "${root}")
    message(FATAL_ERROR "Renderer test fixture already exists.")
endif()
file(MAKE_DIRECTORY "${root}/source" "${root}/output")
file(WRITE "${root}/source/a.js" "first")
file(WRITE "${root}/source/b.css" "style")
file(WRITE "${root}/output/unknown.txt" "preserve")
file(WRITE "${root}/manifest.txt" "a.js\nb.css\n")
function(sync_renderer expected)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE=${root}/source"
        "-DDESTINATION=${root}/output" "-DMANIFEST=${root}/manifest.txt"
        -P "${PROJECT_ROOT}/cmake/SyncRenderer.cmake" RESULT_VARIABLE result)
    if(expected AND NOT result EQUAL 0)
        message(FATAL_ERROR "Renderer synchronization failed.")
    elseif(NOT expected AND result EQUAL 0)
        message(FATAL_ERROR "Renderer accepted an escaping previous manifest.")
    endif()
endfunction()
sync_renderer(TRUE)
file(READ "${root}/output/a.js" content)
if(NOT content STREQUAL "first" OR NOT EXISTS "${root}/output/b.css")
    message(FATAL_ERROR "Renderer did not copy initial assets.")
endif()
file(WRITE "${root}/source/a.js" "changed")
file(WRITE "${root}/manifest.txt" "a.js\n")
sync_renderer(TRUE)
file(READ "${root}/output/a.js" content)
if(NOT content STREQUAL "changed" OR EXISTS "${root}/output/b.css"
    OR NOT EXISTS "${root}/output/unknown.txt")
    message(FATAL_ERROR "Renderer failed to update, remove obsolete assets, or preserve unknown files.")
endif()
sync_renderer(TRUE)
file(WRITE "${root}/keep.txt" "private")
file(WRITE "${root}/output/.spoon-assets.txt" "../keep.txt\n")
sync_renderer(FALSE)
if(NOT EXISTS "${root}/keep.txt")
    message(FATAL_ERROR "Renderer removed a file outside its output directory.")
endif()
