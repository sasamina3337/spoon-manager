cmake_minimum_required(VERSION 3.25)
# Synchronize only changed assets and remove files recorded by our own manifest.
if(NOT IS_ABSOLUTE "${SOURCE}" OR NOT IS_ABSOLUTE "${DESTINATION}" OR IS_SYMLINK "${DESTINATION}")
    message(FATAL_ERROR "Renderer synchronization requires absolute, unlinked directories.")
endif()
file(STRINGS "${MANIFEST}" assets ENCODING UTF-8)
set(previous "${DESTINATION}/.spoon-assets.txt")
if(EXISTS "${previous}")
    file(STRINGS "${previous}" old_assets ENCODING UTF-8)
    foreach(relative IN LISTS old_assets)
        if(IS_ABSOLUTE "${relative}" OR relative MATCHES "(^|[/\\])\\.\\.([/\\]|$)" OR relative MATCHES ":")
            message(FATAL_ERROR "Invalid previous renderer asset path.")
        endif()
        if(NOT relative IN_LIST assets)
            file(REMOVE "${DESTINATION}/${relative}")
        endif()
    endforeach()
endif()
foreach(relative IN LISTS assets)
    get_filename_component(parent "${DESTINATION}/${relative}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    configure_file("${SOURCE}/${relative}" "${DESTINATION}/${relative}" COPYONLY)
endforeach()
configure_file("${MANIFEST}" "${previous}" COPYONLY)
