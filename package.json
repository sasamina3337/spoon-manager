{
  "name": "spoon-manager",
  "version": "2.9.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./spoon.ps1 start",
    "launch": "powershell -NoProfile -ExecutionPolicy Bypass -File ./spoon.ps1 launch",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./spoon.ps1 build",
    "build:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File ./spoon.ps1 build --debug",
    "test": "powershell -NoProfile -ExecutionPolicy Bypass -File ./spoon.ps1 test",
    "test:ui": "node --test",
    "clean": "powershell -NoProfile -ExecutionPolicy Bypass -File ./spoon.ps1 clean",
    "check": "powershell -NoProfile -ExecutionPolicy Bypass -File ./spoon.ps1 check"
  },
  "devDependencies": {
    "jsdom": "24.1.3"
  }
}
